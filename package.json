{
  "name": "alert-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,bff -c cyan,magenta \"npm:web\" \"npm:server\"",
    "web": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "refresh:occupied": "node scripts/refresh-occupied.mjs",
    "refresh:dsm": "node scripts/refresh-dsm.mjs",
    "refresh:ru-alerts": "node scripts/refresh-ru-alerts.mjs",
    "refresh:warspotting": "node scripts/refresh-warspotting.mjs",
    "refresh:rf-sightings": "node scripts/refresh-rf-sightings.mjs",
    "refresh:geoconfirmed-ground": "node scripts/refresh-geoconfirmed-ground.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.15",
    "maplibre-gl": "^5.7.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
